{
  "name": "desktop-roshumble_dev-x862",
   "build": {
    "dockerfile": "../docker/Dockerfile.desktop.humble",
    "context": "../"
  },

  "initializeCommand": "xhost +local:root",

  "containerUser": "root",
  "remoteUser": "root",


  "runArgs": [
    "--privileged",
    "--gpus", "all",
    "--network=host",
    "--pid=host",
    "--ipc=host",
	  "--volume", "/tmp/.X11-unix:/tmp/.X11-unix",
	  "--volume", "/dev:/dev",
	  "--volume", "/dev/shm:/dev/shm"
  ],

  "workspaceMount": "source=${localWorkspaceFolder}/ros2_ws,target=/root/ros2_ws,type=bind",
  "workspaceFolder": "/root/ros2_ws",
  "postStartCommand": "if ! grep -Fq \"'exec' /root/ros2_ws/.pixi/envs/default/bin/python\" .pixi/envs/default/bin/ros2 2>/dev/null; then pixi clean --environment default || true; pixi install; fi",

  "containerEnv": {
    "ROS_DISTRO": "humble",
    "DISPLAY": "${localEnv:DISPLAY}",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}", 
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system"
      }
    }
  }

}