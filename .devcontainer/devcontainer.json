{
  "name": "desktop-roshumble_dev-x862",
   "build": {
    "dockerfile": "../docker/Dockerfile.desktop.humble",
    "context": "../"
  },

  "initializeCommand": "xhost +local:root",

  "containerUser": "ros_user",
  "remoteUser": "ros_user",


  "runArgs": [
    "--privileged",
    "--gpus", "all",
    "--network=host",
    "--pid=host",
    "--ipc=host",
    "--hostname=ros-dev",
	  "--volume", "/tmp/.X11-unix:/tmp/.X11-unix",
	  "--volume", "/dev:/dev",
	  "--volume", "/dev/shm:/dev/shm"
  ],

  "mounts": [
    "target=/run/user/1000,type=tmpfs"
  ],

  "postStartCommand": "cd ros2_ws && pixi install",

  "containerEnv": {
    "ROS_DISTRO": "humble",
    "DISPLAY": "${localEnv:DISPLAY}",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}", 
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "LIBGL_ALWAYS_SOFTWARE": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system"
      }
    }
  }

}