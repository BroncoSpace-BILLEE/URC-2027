ARG UBUNTU_MAJOR=22
ARG UBUNTU_MINOR=04

FROM ubuntu:${UBUNTU_MAJOR}.${UBUNTU_MINOR}

ARG PIXI_VERSION=0.76.1
ARG DEBIAN_FRONTEND=noninteractive

ENV TZ=Europe/Paris
ENV PIXI_HOME=/opt/pixi
ENV PATH=${PIXI_HOME}/bin:${PATH}

RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone && \
    apt-get update && \
    apt-get install --yes --no-install-recommends \
      bash-completion \
      build-essential \
      cmake \
      curl \
      git \
      jq \
      less \
      libopencv-dev \
      libpq-dev \
      lsb-release \
      python3 \
      python3-dev \
      python3-pip \
      python3-wheel \
      tmux \
      wget \
      zstd && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v${PIXI_VERSION} PIXI_HOME=${PIXI_HOME} bash

WORKDIR /root/ros2_ws

COPY ros2_ws/pixi.toml ros2_ws/pixi.lock ./
RUN pixi install --environment mac-cpu

COPY ros2_ws ./
RUN if [ -d src ]; then pixi run --environment mac-cpu build; fi

CMD ["bash"]
