<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="macros.xacro" />

    <gazebo reference="base_footprint">
        <xacro:dark_grey/>
    </gazebo>
    <gazebo reference="base_link">
        <xacro:white/>
    </gazebo>
    <gazebo reference="suspension_1_right_1">
        <xacro:dark_grey/>
    </gazebo>
    <gazebo reference="suspension_1_left_1">
        <xacro:dark_grey/>
    </gazebo>
    <gazebo reference="suspension_2_right_1">
        <xacro:dark_grey/>
    </gazebo>
    <gazebo reference="suspension_2_left_1">
        <xacro:dark_grey/>
    </gazebo>
    <gazebo reference="wheel_r_3">
        <xacro:black/>
    </gazebo>
    <gazebo reference="wheel_r_2">
        <xacro:black/>
    </gazebo>
    <gazebo reference="wheel_r_1">
        <xacro:black/>
    </gazebo>
    <gazebo reference="wheel_1">
        <xacro:black/>
    </gazebo>
    <gazebo reference="wheel_2">
        <xacro:black/>
    </gazebo>
    <gazebo reference="wheel_3">
        <xacro:black/>
    </gazebo>
    <gazebo reference="camera_link">
        <xacro:orange/>
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>/camera/image_raw</topic>
            <!-- Match image headers to the URDF frame published by
                 robot_state_publisher; avoids a Gazebo-specific static TF. -->
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <camera_info_topic>/camera/camera_info</camera_info_topic>
                <optical_frame_id>camera_link_optical</optical_frame_id>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>


    <gazebo>
        <!-- Render and publish camera / GPU sensor data for this spawned model. -->
        <plugin name="ignition::gazebo::systems::Sensors" filename="libignition-gazebo-sensors-system.so">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin name="ignition::gazebo::systems::DiffDrive" filename="libignition-gazebo-diff-drive-system.so">

            <left_joint>joint_wheel_l1</left_joint>
            <left_joint>joint_wheel_l2</left_joint>
            <left_joint>joint_wheel_l3</left_joint>
            
            <right_joint>joint_wheel_r1</right_joint>
            <right_joint>joint_wheel_r2</right_joint>
            <right_joint>joint_wheel_r3</right_joint>

            <wheel_separation>.67</wheel_separation>
            <wheel_radius>.22</wheel_radius>


            <odom_publish_frequency>50</odom_publish_frequency>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>

        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="ignition::gazebo::systems::JointStatePublisher" filename="libignition-gazebo-joint-state-publisher-system.so">
            <joint_name>joint_wheel_r1</joint_name>
            <joint_name>joint_wheel_r2</joint_name>
            <joint_name>joint_wheel_r3</joint_name>
            <joint_name>joint_wheel_l1</joint_name>
            <joint_name>joint_wheel_l2</joint_name>
            <joint_name>joint_wheel_l3</joint_name>
        </plugin>
    </gazebo>

</robot>
